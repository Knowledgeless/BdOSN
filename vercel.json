{
  "buildCommand": "bash build.sh",
  "functions": {
    "api/index.py": {
      "includeFiles": "staticfiles/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/cron/archive-expired-bookings/",
      "schedule": "0 0 * * *"
    }
  ]
}
